{% comment %}
  Multi-Column Section - Flexible 2-4 column grid
  Each column has optional image, heading, text, and link
{% endcomment %}

<section class="multicol-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="multicol-container">
    {% if section.settings.heading != blank %}
      <h2 class="multicol-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="multicol-grid multicol-grid--{{ section.settings.columns_per_row }}">
        {% for block in section.blocks %}
          <div class="multicol-item {% if section.settings.enable_border %}multicol-item--bordered{% endif %}" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <div class="multicol-image">
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.heading | escape }}"
                  loading="lazy"
                  width="800"
                  height="600"
                />
              </div>
            {% endif %}
            {% if block.settings.heading != blank %}
              <h3 class="multicol-item-heading">{{ block.settings.heading }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <p class="multicol-item-text">{{ block.settings.text }}</p>
            {% endif %}
            {% if block.settings.link_text != blank and block.settings.link_url != blank %}
              <a href="{{ block.settings.link_url }}" class="multicol-item-link">
                {{ block.settings.link_text }}
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="multicol-grid multicol-grid--3">
        {% for i in (1..3) %}
          <div class="multicol-item multicol-item--bordered" style="opacity: 0.5;">
            <h3 class="multicol-item-heading">Column {{ i }}</h3>
            <p class="multicol-item-text">Add columns in the theme editor to populate this section.</p>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
.multicol-section {
  padding-left: 3rem;
  padding-right: 3rem;
}

.multicol-container {
  max-width: 1400px;
  margin: 0 auto;
}

.multicol-heading {
  font-size: 1.5rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0;
  margin: 0 0 2.5rem;
  text-align: center;
  color: var(--color-text);
}

.multicol-grid {
  display: grid;
  gap: 2rem;
}

.multicol-grid--2 {
  grid-template-columns: repeat(2, 1fr);
}

.multicol-grid--3 {
  grid-template-columns: repeat(3, 1fr);
}

.multicol-grid--4 {
  grid-template-columns: repeat(4, 1fr);
}

.multicol-item {
  text-align: center;
}

.multicol-item--bordered {
  border: 2px solid var(--color-border);
  padding: 2rem;
}

.multicol-image {
  margin-bottom: 1.5rem;
  overflow: hidden;
}

.multicol-image img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
}

.multicol-item-heading {
  font-size: 1rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0;
  margin: 0 0 0.75rem;
  color: var(--color-text);
}

.multicol-item-text {
  font-size: 0.875rem;
  line-height: 1.7;
  color: var(--color-muted);
  margin: 0 0 1rem;
}

.multicol-item-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0;
  color: var(--color-text);
  text-decoration: none;
  border-bottom: 2px solid var(--color-text);
  padding-bottom: 0.25rem;
  transition: all 0.2s ease;
}

.multicol-item-link:hover {
  color: var(--color-muted);
  border-color: var(--color-muted);
}

@media (max-width: 1024px) {
  .multicol-grid--4 {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  .multicol-section {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .multicol-grid--2,
  .multicol-grid--3,
  .multicol-grid--4 {
    grid-template-columns: 1fr;
  }

  .multicol-heading {
    font-size: 1.25rem;
  }
}
</style>

{% schema %}
{
  "name": "Multi-Column",
  "tag": "section",
  "class": "multicol-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "columns_per_row",
      "label": "Columns Per Row",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "3"
    },
    {
      "type": "checkbox",
      "id": "enable_border",
      "label": "Enable Column Borders",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Column heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Pair text with an image to add detail to your chosen content."
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multi-Column",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}
