{% comment %}
  Main Article Section - Blog Post Page
  Block-based article layout with reorderable content
{% endcomment %}

<div class="article-page" style="max-width: {{ section.settings.content_width }}px;">
  {% if section.settings.show_breadcrumbs %}
    <nav class="breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>/</span>
      <a href="{{ blog.url }}">{{ blog.title }}</a>
      <span>/</span>
      <span>{{ article.title }}</span>
    </nav>
  {% endif %}

  <article class="article-detail">
    {% for block in section.blocks %}
      {% case block.type %}

        {% when 'title' %}
          <header class="article-header" {{ block.shopify_attributes }}>
            {% if section.settings.show_tags and article.tags.size > 0 %}
              <div class="article-tags">
                {% for tag in article.tags %}
                  <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="article-tag">{{ tag }}</a>
                {% endfor %}
              </div>
            {% endif %}

            <h1 class="article-title">{{ article.title }}</h1>

            <div class="article-meta">
              {% if section.settings.show_author %}
                <span class="article-author">By {{ article.author }}</span>
              {% endif %}
              {% if section.settings.show_date %}
                <span class="article-date">{{ article.published_at | date: '%B %d, %Y' }}</span>
              {% endif %}
              {% if section.settings.show_comment_count and article.comments_count > 0 %}
                <span class="article-comments-count">{{ article.comments_count }} {% if article.comments_count == 1 %}Comment{% else %}Comments{% endif %}</span>
              {% endif %}
            </div>
          </header>

        {% when 'featured_image' %}
          {% if article.image %}
            <div class="article-featured-image article-featured-image--{{ section.settings.image_height }}" {{ block.shopify_attributes }}>
              <img
                src="{{ article.image | image_url: width: 1200 }}"
                alt="{{ article.image.alt | default: article.title | escape }}"
                width="{{ article.image.width }}"
                height="{{ article.image.height }}"
                loading="eager"
              >
            </div>
          {% endif %}

        {% when 'content' %}
          {% if article.content != blank %}
            <div class="article-content rte" {{ block.shopify_attributes }}>
              {{ article.content }}
            </div>
          {% endif %}

        {% when 'share' %}
          <div class="article-share" {{ block.shopify_attributes }}>
            <span class="share-label">Share:</span>
            <div class="share-buttons">
              {% if block.settings.show_facebook %}
                <a
                  href="https://www.facebook.com/sharer.php?u={{ shop.url }}{{ article.url }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="share-btn"
                  aria-label="Share on Facebook"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                  </svg>
                </a>
              {% endif %}
              {% if block.settings.show_twitter %}
                <a
                  href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ article.url }}&text={{ article.title | url_encode }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="share-btn"
                  aria-label="Share on Twitter"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/>
                  </svg>
                </a>
              {% endif %}
              {% if block.settings.show_pinterest %}
                <a
                  href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ article.url }}&description={{ article.title | url_encode }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="share-btn"
                  aria-label="Share on Pinterest"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2C6.5 2 2 6.5 2 12c0 4.2 2.6 7.8 6.4 9.3-.1-.7-.1-1.9.1-2.7l.9-3.8s-.2-.5-.2-1.2c0-1.2.7-2 1.5-2 .7 0 1 .5 1 1.1 0 .7-.4 1.7-.7 2.7-.2.8.4 1.4 1.2 1.4 1.4 0 2.5-1.5 2.5-3.7 0-1.9-1.4-3.3-3.4-3.3-2.3 0-3.7 1.7-3.7 3.5 0 .7.3 1.4.6 1.8.1.1.1.1 0 .2l-.2.9c0 .2-.1.2-.3.1-1.1-.5-1.7-2-1.7-3.3 0-2.7 2-5.2 5.6-5.2 3 0 5.3 2.1 5.3 5 0 3-1.9 5.3-4.4 5.3-.9 0-1.7-.5-2-1l-.5 2c-.2.8-.7 1.6-1.1 2.1.8.3 1.7.4 2.6.4 5.5 0 10-4.5 10-10S17.5 2 12 2z"/>
                  </svg>
                </a>
              {% endif %}
            </div>
          </div>

        {% when 'next_prev' %}
          {% if blog.next_article or blog.previous_article %}
            <div class="article-navigation" {{ block.shopify_attributes }}>
              {% if blog.previous_article %}
                <a href="{{ blog.previous_article.url }}" class="article-nav-link article-nav-prev">
                  <span class="nav-label">&larr; Previous</span>
                  <span class="nav-title">{{ blog.previous_article.title | truncate: 50 }}</span>
                </a>
              {% endif %}
              {% if blog.next_article %}
                <a href="{{ blog.next_article.url }}" class="article-nav-link article-nav-next">
                  <span class="nav-label">Next &rarr;</span>
                  <span class="nav-title">{{ blog.next_article.title | truncate: 50 }}</span>
                </a>
              {% endif %}
            </div>
          {% endif %}

        {% when 'comments' %}
          {% if blog.comments_enabled? %}
            <div class="article-comments-section" {{ block.shopify_attributes }}>
              <h2 class="comments-title">
                {% if article.comments_count > 0 %}
                  {{ article.comments_count }} {% if article.comments_count == 1 %}Comment{% else %}Comments{% endif %}
                {% else %}
                  Leave a Comment
                {% endif %}
              </h2>

              {% if article.comments_count > 0 %}
                <div class="comments-list">
                  {% paginate article.comments by 50 %}
                    {% for comment in article.comments %}
                      <div class="comment" id="comment-{{ comment.id }}">
                        <div class="comment-header">
                          <span class="comment-author">{{ comment.author }}</span>
                          <span class="comment-date">{{ comment.created_at | date: '%B %d, %Y at %I:%M %p' }}</span>
                        </div>
                        <div class="comment-content">
                          {{ comment.content }}
                        </div>
                      </div>
                    {% endfor %}

                    {% if paginate.pages > 1 %}
                      <div class="pagination">
                        {% if paginate.previous %}
                          <a href="{{ paginate.previous.url }}" class="pagination-btn">Previous</a>
                        {% endif %}
                        {% if paginate.next %}
                          <a href="{{ paginate.next.url }}" class="pagination-btn">Next</a>
                        {% endif %}
                      </div>
                    {% endif %}
                  {% endpaginate %}
                </div>
              {% endif %}

              <div class="comment-form-wrapper">
                <h3 class="comment-form-title">Add a Comment</h3>

                {% form 'new_comment', article %}
                  {% if form.posted_successfully? %}
                    <div class="form-success">
                      {% if blog.moderated? %}
                        Your comment has been submitted and will appear once approved.
                      {% else %}
                        Your comment has been posted successfully!
                      {% endif %}
                    </div>
                  {% endif %}

                  {% if form.errors %}
                    <div class="form-errors">
                      {{ form.errors | default_errors }}
                    </div>
                  {% endif %}

                  <div class="form-row">
                    <div class="form-field">
                      <label for="CommentAuthor">Name *</label>
                      <input
                        type="text"
                        name="comment[author]"
                        id="CommentAuthor"
                        class="form-input"
                        value="{{ form.author }}"
                        required
                        autocomplete="name"
                      >
                    </div>
                    <div class="form-field">
                      <label for="CommentEmail">Email *</label>
                      <input
                        type="email"
                        name="comment[email]"
                        id="CommentEmail"
                        class="form-input"
                        value="{{ form.email }}"
                        required
                        autocomplete="email"
                      >
                    </div>
                  </div>

                  <div class="form-field">
                    <label for="CommentBody">Comment *</label>
                    <textarea
                      name="comment[body]"
                      id="CommentBody"
                      class="form-textarea"
                      required
                    >{{ form.body }}</textarea>
                  </div>

                  <button type="submit" class="btn-submit">Post Comment</button>
                {% endform %}
              </div>
            </div>
          {% endif %}

        {% when 'related' %}
          {% if blog.articles_count > 1 %}
            <aside class="related-articles" {{ block.shopify_attributes }}>
              <h2 class="related-title">{{ block.settings.heading | default: 'More from the Blog' }}</h2>
              <div class="related-grid">
                {% assign related_limit = block.settings.articles_count | plus: 1 %}
                {% assign related_count = 0 %}
                {% for blog_article in blog.articles limit: related_limit %}
                  {% unless blog_article.id == article.id %}
                    {% assign related_count = related_count | plus: 1 %}
                    {% if related_count <= block.settings.articles_count %}
                      <a href="{{ blog_article.url }}" class="related-article-card">
                        {% if blog_article.image %}
                          <div class="related-article-image">
                            <img
                              src="{{ blog_article.image | image_url: width: 400 }}"
                              alt="{{ blog_article.title | escape }}"
                              width="{{ blog_article.image.width }}"
                              height="{{ blog_article.image.height }}"
                              loading="lazy"
                            >
                          </div>
                        {% endif %}
                        <div class="related-article-content">
                          <h3>{{ blog_article.title }}</h3>
                          <span class="related-article-date">{{ blog_article.published_at | date: '%B %d, %Y' }}</span>
                        </div>
                      </a>
                    {% endif %}
                  {% endunless %}
                {% endfor %}
              </div>
            </aside>
          {% endif %}

      {% endcase %}
    {% endfor %}
  </article>
</div>

<style>
.article-page {
  padding-top: 60px;
  min-height: 100vh;
  margin: 0 auto;
  padding-left: 2rem;
  padding-right: 2rem;
}

/* Breadcrumb */
.breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 1.25rem 0;
  font-size: 0.75rem;
}

.breadcrumb a {
  color: var(--color-muted);
  text-decoration: none;
}

.breadcrumb a:hover {
  color: var(--color-text);
}

.breadcrumb span {
  color: var(--color-muted);
}

.breadcrumb span:last-child {
  color: var(--color-text);
}

/* Article Detail */
.article-detail {
  padding-bottom: 4rem;
}

/* Header */
.article-header {
  text-align: center;
  padding: 2rem 0 2.5rem;
}

.article-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  justify-content: center;
  margin-bottom: 1.25rem;
}

.article-tag {
  font-size: 0.65rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-muted);
  text-decoration: none;
  padding: 0.25rem 0.75rem;
  border: 1px solid var(--color-border);
}

.article-tag:hover {
  color: var(--color-text);
  border-color: var(--color-text);
}

.article-title {
  font-size: 2.25rem;
  font-weight: 700;
  line-height: 1.2;
  margin: 0 0 1.25rem;
}

.article-meta {
  display: flex;
  gap: 1.5rem;
  justify-content: center;
  font-size: 0.875rem;
  color: var(--color-muted);
}

/* Featured Image */
.article-featured-image {
  overflow: hidden;
  border: 2px solid var(--color-border);
  margin-bottom: 2.5rem;
}

.article-featured-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.article-featured-image--adapt {
  height: auto;
}

.article-featured-image--adapt img {
  height: auto;
  object-fit: contain;
}

.article-featured-image--small {
  max-height: 300px;
}

.article-featured-image--medium {
  max-height: 450px;
}

.article-featured-image--large {
  max-height: 600px;
}

/* Article Content (RTE) */
.article-content {
  font-size: 1.05rem;
  line-height: 1.8;
  color: var(--color-text);
  padding-bottom: 2.5rem;
  border-bottom: 2px solid var(--color-border);
  margin-bottom: 2rem;
}

.rte h2 {
  font-size: 1.5rem;
  font-weight: 700;
  margin: 2.5rem 0 1rem;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid var(--color-border);
}

.rte h3 {
  font-size: 1.25rem;
  font-weight: 700;
  margin: 2rem 0 1rem;
}

.rte p {
  margin: 0 0 1.5rem;
}

.rte a {
  color: var(--color-text);
  text-decoration: underline;
  font-weight: 500;
}

.rte a:hover {
  text-decoration: none;
}

.rte img {
  max-width: 100%;
  height: auto;
  margin: 2rem 0;
  border: 2px solid var(--color-border);
}

.rte ul,
.rte ol {
  margin: 0 0 1.5rem;
  padding-left: 2rem;
}

.rte li {
  margin-bottom: 0.5rem;
}

.rte blockquote {
  margin: 2rem 0;
  padding: 1.5rem 2rem;
  border-left: 4px solid var(--color-text);
  background: var(--color-cream, #f5f5f5);
  font-style: italic;
  color: var(--color-muted);
}

/* Share */
.article-share {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.5rem 0;
  margin-bottom: 1.5rem;
}

.share-label {
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
}

.share-buttons {
  display: flex;
  gap: 0.5rem;
}

.share-btn {
  width: 40px;
  height: 40px;
  border: 2px solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text);
  text-decoration: none;
  transition: all 0.2s ease;
}

.share-btn:hover {
  background: var(--color-text);
  color: var(--color-bg);
  border-color: var(--color-text);
}

/* Navigation */
.article-navigation {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
  margin-bottom: 2.5rem;
}

.article-nav-link {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding: 1.5rem;
  border: 2px solid var(--color-border);
  text-decoration: none;
  color: var(--color-text);
  transition: border-color 0.2s ease;
}

.article-nav-link:hover {
  border-color: var(--color-text);
}

.article-nav-next {
  text-align: right;
}

.nav-label {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--color-muted);
}

.nav-title {
  font-size: 0.9rem;
  font-weight: 500;
}

/* Comments */
.article-comments-section {
  padding: 2.5rem 0;
  border-top: 2px solid var(--color-border);
}

.comments-title {
  font-size: 1.1rem;
  font-weight: 700;
  text-transform: uppercase;
  margin: 0 0 2rem;
  padding-bottom: 1rem;
  border-bottom: 2px solid var(--color-border);
}

.comments-list {
  margin-bottom: 3rem;
}

.comment {
  padding: 1.5rem;
  margin-bottom: 1rem;
  border: 1px solid var(--color-border);
  background: var(--color-cream, #f5f5f5);
}

.comment-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 0.75rem;
  font-size: 0.875rem;
}

.comment-author {
  font-weight: 700;
}

.comment-date {
  color: var(--color-muted);
}

.comment-content {
  font-size: 0.95rem;
  line-height: 1.7;
}

.comment-form-wrapper {
  padding: 2rem;
  border: 2px solid var(--color-border);
}

.comment-form-title {
  font-size: 0.95rem;
  font-weight: 700;
  text-transform: uppercase;
  margin: 0 0 1.5rem;
}

.form-success,
.form-errors {
  padding: 1rem;
  margin-bottom: 1.5rem;
  border: 2px solid var(--color-border);
  font-size: 0.9rem;
}

.form-success {
  background: #dcfce7;
  border-color: #166534;
  color: #166534;
}

.form-errors {
  background: #fde2e2;
  border-color: #991b1b;
  color: #991b1b;
}

.form-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
}

.form-field {
  margin-bottom: 1rem;
}

.form-field label {
  display: block;
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  margin-bottom: 0.5rem;
}

.form-input,
.form-textarea {
  width: 100%;
  padding: 0.875rem;
  border: 2px solid var(--color-border);
  font-family: inherit;
  font-size: 0.95rem;
  background: var(--color-bg);
}

.form-input:focus,
.form-textarea:focus {
  outline: none;
  border-color: var(--color-text);
}

.form-textarea {
  min-height: 140px;
  resize: vertical;
}

.btn-submit {
  padding: 0.875rem 2rem;
  background: var(--color-text);
  color: var(--color-bg);
  border: 2px solid var(--color-text);
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-submit:hover {
  background: transparent;
  color: var(--color-text);
}

.pagination {
  display: flex;
  justify-content: center;
  gap: 0.5rem;
  margin-top: 2rem;
}

.pagination-btn {
  padding: 0.5rem 1rem;
  border: 1px solid var(--color-border);
  background: var(--color-bg);
  color: var(--color-text);
  text-decoration: none;
  font-size: 0.875rem;
}

.pagination-btn:hover {
  border-color: var(--color-text);
}

/* Related Articles */
.related-articles {
  padding: 2.5rem 0;
  border-top: 2px solid var(--color-border);
}

.related-title {
  font-size: 1.1rem;
  font-weight: 700;
  text-transform: uppercase;
  margin: 0 0 2rem;
}

.related-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.related-article-card {
  border: 2px solid var(--color-border);
  text-decoration: none;
  color: var(--color-text);
  display: flex;
  flex-direction: column;
  transition: border-color 0.2s ease;
}

.related-article-card:hover {
  border-color: var(--color-text);
}

.related-article-image {
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background: var(--color-cream, #f5f5f5);
}

.related-article-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.related-article-card:hover .related-article-image img {
  transform: scale(1.03);
}

.related-article-content {
  padding: 1.25rem;
}

.related-article-content h3 {
  font-size: 0.95rem;
  font-weight: 500;
  margin: 0 0 0.5rem;
  line-height: 1.3;
}

.related-article-date {
  font-size: 0.75rem;
  color: var(--color-muted);
}

/* Responsive */
@media (max-width: 768px) {
  .article-page {
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .article-title {
    font-size: 1.6rem;
  }

  .article-meta {
    flex-direction: column;
    gap: 0.5rem;
  }

  .article-navigation {
    grid-template-columns: 1fr;
  }

  .article-nav-next {
    text-align: left;
  }

  .form-row {
    grid-template-columns: 1fr;
  }

  .related-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 480px) {
  .breadcrumb {
    flex-wrap: wrap;
  }
}
</style>

{% schema %}
{
  "name": "Article Page",
  "tag": "section",
  "class": "main-article",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show Breadcrumbs",
      "default": true
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 700,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Content Width",
      "default": 800
    },
    {
      "type": "header",
      "content": "Article Info"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show Tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show Author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show Date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_comment_count",
      "label": "Show Comment Count",
      "default": true
    },
    {
      "type": "header",
      "content": "Featured Image"
    },
    {
      "type": "select",
      "id": "image_height",
      "label": "Image Height",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "small", "label": "Small (300px)" },
        { "value": "medium", "label": "Medium (450px)" },
        { "value": "large", "label": "Large (600px)" }
      ],
      "default": "medium"
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "featured_image",
      "name": "Featured Image",
      "limit": 1,
      "settings": []
    },
    {
      "type": "content",
      "name": "Article Content",
      "limit": 1,
      "settings": []
    },
    {
      "type": "share",
      "name": "Share Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_facebook",
          "label": "Show Facebook",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_twitter",
          "label": "Show Twitter / X",
          "default": true
        },
