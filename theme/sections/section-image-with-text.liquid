{% comment %}
  Image with Text Section - Split layout with image and content
  Configurable image position, width, and height
{% endcomment %}

<section class="iwt-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="iwt-grid iwt--image-{{ section.settings.image_position }}" style="{% if section.settings.section_height != 'auto' %}min-height: {{ section.settings.section_height }}px;{% endif %}">
    <div class="iwt-image" style="{% if section.settings.image_width == '40' %}flex: 0 0 40%;{% elsif section.settings.image_width == '60' %}flex: 0 0 60%;{% else %}flex: 0 0 50%;{% endif %}">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.heading | escape }}"
          loading="lazy"
          width="1200"
          height="800"
        />
      {% else %}
        <div class="iwt-placeholder">
          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
            <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
            <circle cx="9" cy="9" r="2"></circle>
            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
          </svg>
        </div>
      {% endif %}
    </div>
    <div class="iwt-content">
      {% if section.settings.heading != blank %}
        <h2 class="iwt-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="iwt-body rte">
          {{ section.settings.body }}
        </div>
      {% endif %}
      {% if section.settings.button_text != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="iwt-btn">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
.iwt-section {
  padding-left: 3rem;
  padding-right: 3rem;
  max-width: 1400px;
  margin: 0 auto;
}

.iwt-grid {
  display: flex;
  gap: 4rem;
  align-items: center;
}

.iwt--image-right {
  flex-direction: row-reverse;
}

.iwt-image {
  overflow: hidden;
}

.iwt-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.iwt-placeholder {
  width: 100%;
  height: 400px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border: 2px dashed var(--color-border);
  color: var(--color-muted);
}

.iwt-content {
  flex: 1;
}

.iwt-heading {
  font-size: 1.5rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0;
  margin: 0 0 1.5rem;
  color: var(--color-text);
}

.iwt-body {
  font-size: 0.9rem;
  line-height: 1.8;
  color: var(--color-text);
  margin-bottom: 2rem;
}

.iwt-body p {
  margin: 0 0 1.25rem;
  color: var(--color-muted);
}

.iwt-body p:last-child {
  margin-bottom: 0;
}

.iwt-btn {
  display: inline-block;
  padding: 0.75rem 1.5rem;
  background: var(--color-text);
  color: var(--color-bg);
  border: 2px solid var(--color-text);
  font-size: 0.875rem;
  font-weight: 700;
  letter-spacing: 0;
  text-transform: uppercase;
  text-decoration: none;
  transition: all 0.2s ease;
}

.iwt-btn:hover {
  background: transparent;
  color: var(--color-text);
}

@media (max-width: 768px) {
  .iwt-section {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .iwt-grid,
  .iwt--image-right {
    flex-direction: column;
    gap: 2rem;
  }

  .iwt-image {
    flex: none !important;
    width: 100%;
  }

  .iwt-image img {
    height: 350px;
  }

  .iwt-heading {
    font-size: 1.25rem;
  }
}
</style>

{% schema %}
{
  "name": "Image with Text",
  "tag": "section",
  "class": "iwt-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_width",
      "label": "Image Width",
      "options": [
        { "value": "40", "label": "40%" },
        { "value": "50", "label": "50%" },
        { "value": "60", "label": "60%" }
      ],
      "default": "50"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image with text"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body Text",
      "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section Height",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "400", "label": "400px" },
        { "value": "500", "label": "500px" },
        { "value": "600", "label": "600px" }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Image with Text"
    }
  ]
}
{% endschema %}
