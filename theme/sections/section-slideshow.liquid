{% comment %}
  Slideshow Section - Image carousel with arrows, dots, auto-play
  Each slide has optional text overlay and button
{% endcomment %}

<section class="slideshow-section">
  {% if section.blocks.size > 0 %}
    <div class="slideshow" data-slideshow="{{ section.id }}" data-autoplay="{{ section.settings.auto_play }}" data-speed="{{ section.settings.slide_speed }}">
      <div class="slideshow-track" style="height: {{ section.settings.slide_height }}px;">
        {% for block in section.blocks %}
          <div class="slideshow-slide {% if forloop.first %}slideshow-slide--active{% endif %}" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <img
                class="slideshow-image"
                src="{{ block.settings.image | image_url: width: 2000 }}"
                alt="{{ block.settings.heading | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                width="2000"
                height="{{ section.settings.slide_height }}"
              />
            {% else %}
              <div class="slideshow-placeholder"></div>
            {% endif %}
            <div class="slideshow-overlay" style="background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});"></div>
            {% if block.settings.heading != blank or block.settings.subheading != blank or block.settings.button_text != blank %}
              <div class="slideshow-content">
                {% if block.settings.heading != blank %}
                  <h2 class="slideshow-heading">{{ block.settings.heading }}</h2>
                {% endif %}
                {% if block.settings.subheading != blank %}
                  <p class="slideshow-subheading">{{ block.settings.subheading }}</p>
                {% endif %}
                {% if block.settings.button_text != blank and block.settings.button_link != blank %}
                  <a href="{{ block.settings.button_link }}" class="slideshow-btn">
                    {{ block.settings.button_text }}
                  </a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      {% if section.blocks.size > 1 %}
        <button class="slideshow-arrow slideshow-arrow--prev" data-slide-prev aria-label="Previous slide">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"></path></svg>
        </button>
        <button class="slideshow-arrow slideshow-arrow--next" data-slide-next aria-label="Next slide">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"></path></svg>
        </button>
        <div class="slideshow-dots">
          {% for block in section.blocks %}
            <button class="slideshow-dot {% if forloop.first %}slideshow-dot--active{% endif %}" data-slide-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  {% else %}
    <div class="slideshow-empty">
      <p>Add slides in the theme editor.</p>
    </div>
  {% endif %}
</section>

<style>
.slideshow {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.slideshow-track {
  position: relative;
  width: 100%;
}

.slideshow-slide {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 0.6s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.slideshow-slide--active {
  opacity: 1;
  z-index: 1;
}

.slideshow-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.slideshow-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #1a1a1a;
}

.slideshow-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.slideshow-content {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 3rem;
  max-width: 800px;
  color: white;
}

.slideshow-heading {
  font-size: clamp(1.5rem, 4vw, 3rem);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0;
  margin: 0 0 1rem;
  line-height: 1.1;
}

.slideshow-subheading {
  font-size: 1rem;
  line-height: 1.6;
  margin: 0 0 2rem;
  opacity: 0.85;
}

.slideshow-btn {
  display: inline-block;
  padding: 0.75rem 1.5rem;
  background: white;
  color: #000000;
  border: 2px solid white;
  font-size: 0.875rem;
  font-weight: 700;
  letter-spacing: 0;
  text-transform: uppercase;
  text-decoration: none;
  transition: all 0.2s ease;
}

.slideshow-btn:hover {
  background: transparent;
  color: white;
}

.slideshow-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 3;
  background: rgba(0, 0, 0, 0.5);
  color: white;
  border: 2px solid rgba(255, 255, 255, 0.5);
  padding: 0.75rem;
  cursor: pointer;
  transition: all 0.2s ease;
}

.slideshow-arrow:hover {
  background: rgba(0, 0, 0, 0.8);
  border-color: white;
}

.slideshow-arrow--prev {
  left: 1.5rem;
}

.slideshow-arrow--next {
  right: 1.5rem;
}

.slideshow-dots {
  position: absolute;
  bottom: 1.5rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 0.5rem;
  z-index: 3;
}

.slideshow-dot {
  width: 12px;
  height: 12px;
  background: rgba(255, 255, 255, 0.4);
  border: 2px solid rgba(255, 255, 255, 0.6);
  cursor: pointer;
  transition: all 0.2s ease;
  padding: 0;
}

.slideshow-dot--active,
.slideshow-dot:hover {
  background: white;
  border-color: white;
}

.slideshow-empty {
  text-align: center;
  padding: 4rem 3rem;
  color: var(--color-muted);
  background: #f5f5f5;
  border: 2px dashed var(--color-border);
}

@media (max-width: 768px) {
  .slideshow-track {
    height: 350px !important;
  }

  .slideshow-content {
    padding: 2rem 1.5rem;
  }

  .slideshow-arrow {
    display: none;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var slideshow = document.querySelector('[data-slideshow="{{ section.id }}"]');
  if (!slideshow) return;

  var slides = slideshow.querySelectorAll('.slideshow-slide');
  var dots = slideshow.querySelectorAll('.slideshow-dot');
  var total = slides.length;
  if (total <= 1) return;

  var current = 0;
  var autoplay = slideshow.getAttribute('data-autoplay') === 'true';
  var speed = parseInt(slideshow.getAttribute('data-speed'), 10) * 1000;
  var timer = null;

  function goTo(index) {
    slides[current].classList.remove('slideshow-slide--active');
    if (dots[current]) dots[current].classList.remove('slideshow-dot--active');
    current = (index + total) % total;
    slides[current].classList.add('slideshow-slide--active');
    if (dots[current]) dots[current].classList.add('slideshow-dot--active');
  }

  function startAutoplay() {
    if (!autoplay) return;
    timer = setInterval(function() { goTo(current + 1); }, speed);
  }

  function stopAutoplay() {
    clearInterval(timer);
  }

  var prevBtn = slideshow.querySelector('[data-slide-prev]');
  var nextBtn = slideshow.querySelector('[data-slide-next]');

  if (prevBtn) prevBtn.addEventListener('click', function() { stopAutoplay(); goTo(current - 1); startAutoplay(); });
  if (nextBtn) nextBtn.addEventListener('click', function() { stopAutoplay(); goTo(current + 1); startAutoplay(); });

  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      stopAutoplay();
      goTo(parseInt(dot.getAttribute('data-slide-dot'), 10));
      startAutoplay();
    });
  });

  slideshow.addEventListener('mouseenter', stopAutoplay);
  slideshow.addEventListener('mouseleave', startAutoplay);

  startAutoplay();
});
</script>

{% schema %}
{
  "name": "Slideshow",
  "tag": "section",
  "class": "slideshow-section-wrapper",
  "settings": [
    {
      "type": "range",
      "id": "slide_height",
      "min": 300,
      "max": 700,
      "step": 50,
      "unit": "px",
      "label": "Slide Height",
      "default": 500
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 10,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "auto_play",
      "label": "Auto-Play",
      "default": true
    },
    {
      "type": "range",
      "id": "slide_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Slide Duration",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
