{% comment %}
  Testimonials Section - Customer quotes in grid layout
  Each block is a quote with author, role, and star rating
{% endcomment %}

<section class="testimonials-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="testimonials-container">
    {% if section.settings.heading != blank %}
      <h2 class="testimonials-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="testimonials-grid testimonials-grid--{{ section.settings.columns }}">
        {% for block in section.blocks %}
          <div class="testimonial-card" {{ block.shopify_attributes }}>
            {% if block.settings.rating > 0 %}
              <div class="testimonial-stars">
                {% for i in (1..5) %}
                  {% if i <= block.settings.rating %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                  {% else %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
            <blockquote class="testimonial-quote">
              {{ block.settings.quote }}
            </blockquote>
            <div class="testimonial-author">
              <span class="testimonial-name">{{ block.settings.author }}</span>
              {% if block.settings.role != blank %}
                <span class="testimonial-role">{{ block.settings.role }}</span>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="testimonials-empty">
        <p>Add testimonials in the theme editor.</p>
      </div>
    {% endif %}
  </div>
</section>

<style>
.testimonials-section {
  padding-left: 3rem;
  padding-right: 3rem;
}

.testimonials-container {
  max-width: 1400px;
  margin: 0 auto;
}

.testimonials-heading {
  font-size: 1.5rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0;
  margin: 0 0 2.5rem;
  text-align: center;
  color: var(--color-text);
}

.testimonials-grid {
  display: grid;
  gap: 2rem;
}

.testimonials-grid--2 {
  grid-template-columns: repeat(2, 1fr);
}

.testimonials-grid--3 {
  grid-template-columns: repeat(3, 1fr);
}

.testimonial-card {
  border: 2px solid var(--color-border);
  border-left: 4px solid var(--color-accent);
  padding: 2rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.testimonial-stars {
  display: flex;
  gap: 0.25rem;
  color: var(--color-text);
}

.testimonial-quote {
  font-size: 0.9rem;
  line-height: 1.8;
  color: var(--color-text);
  font-style: italic;
  margin: 0;
  flex: 1;
}

.testimonial-author {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  padding-top: 1rem;
  border-top: 1px solid var(--color-border);
}

.testimonial-name {
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0;
  color: var(--color-text);
}

.testimonial-role {
  font-size: 0.75rem;
  color: var(--color-muted);
}

.testimonials-empty {
  text-align: center;
  padding: 3rem;
  color: var(--color-muted);
  border: 2px dashed var(--color-border);
}

@media (max-width: 768px) {
  .testimonials-section {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .testimonials-grid--2,
  .testimonials-grid--3 {
    grid-template-columns: 1fr;
  }

  .testimonials-heading {
    font-size: 1.25rem;
  }
}
</style>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "testimonials-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Amazing quality and unique pieces. Every item I've purchased has been exactly as described."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Customer Name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Title / Location",
          "default": "Verified Buyer"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Star Rating",
          "default": 5,
          "info": "Set to 0 to hide stars"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
