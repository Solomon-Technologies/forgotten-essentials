{% comment %}
  Contact Form Section - Shopify contact form with heading and description
  Optional phone and order number fields
{% endcomment %}

<section class="contact-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="contact-container">
    {% if section.settings.heading != blank %}
      <h2 class="contact-heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.description != blank %}
      <div class="contact-description rte">
        {{ section.settings.description }}
      </div>
    {% endif %}

    {% form 'contact' %}
      {% if form.posted_successfully? %}
        <div class="contact-success">
          <p>Thanks for reaching out! We'll get back to you soon.</p>
        </div>
      {% endif %}

      {% if form.errors %}
        <div class="contact-errors">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="contact-fields">
        <div class="contact-row">
          <div class="contact-field">
            <label for="contact-name-{{ section.id }}">Name</label>
            <input
              type="text"
              id="contact-name-{{ section.id }}"
              name="contact[name]"
              value="{{ form.name }}"
              required
            />
          </div>
          <div class="contact-field">
            <label for="contact-email-{{ section.id }}">Email</label>
            <input
              type="email"
              id="contact-email-{{ section.id }}"
              name="contact[email]"
              value="{{ form.email }}"
              autocapitalize="off"
              required
            />
          </div>
        </div>

        {% if section.settings.show_phone %}
          <div class="contact-field">
            <label for="contact-phone-{{ section.id }}">Phone</label>
            <input
              type="tel"
              id="contact-phone-{{ section.id }}"
              name="contact[phone]"
              value="{{ form.phone }}"
            />
          </div>
        {% endif %}

        {% if section.settings.show_order_number %}
          <div class="contact-field">
            <label for="contact-order-{{ section.id }}">Order Number</label>
            <input
              type="text"
              id="contact-order-{{ section.id }}"
              name="contact[order_number]"
              placeholder="#1001"
            />
          </div>
        {% endif %}

        <div class="contact-field">
          <label for="contact-message-{{ section.id }}">Message</label>
          <textarea
            id="contact-message-{{ section.id }}"
            name="contact[body]"
            rows="6"
            required
          >{{ form.body }}</textarea>
        </div>

        <button type="submit" class="contact-submit">
          Send Message
        </button>
      </div>
    {% endform %}
  </div>
</section>

<style>
.contact-section {
  padding-left: 3rem;
  padding-right: 3rem;
}

.contact-container {
  max-width: 700px;
  margin: 0 auto;
}

.contact-heading {
  font-size: 1.5rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0;
  margin: 0 0 1rem;
  text-align: center;
  color: var(--color-text);
}

.contact-description {
  font-size: 0.9rem;
  line-height: 1.8;
  color: var(--color-muted);
  text-align: center;
  margin-bottom: 2.5rem;
}

.contact-fields {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.contact-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
}

.contact-field label {
  display: block;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0;
  margin-bottom: 0.5rem;
  color: var(--color-text);
}

.contact-field input,
.contact-field textarea {
  width: 100%;
  padding: 0.75rem 1rem;
  border: 2px solid var(--color-border);
  font-family: var(--font-sans);
  font-size: 0.9rem;
  color: var(--color-text);
  background: var(--color-bg);
  transition: border-color 0.2s ease;
}

.contact-field input:focus,
.contact-field textarea:focus {
  outline: none;
  border-color: var(--color-muted);
}

.contact-field textarea {
  resize: vertical;
  min-height: 150px;
}

.contact-submit {
  display: inline-block;
  padding: 0.75rem 2rem;
  background: var(--color-text);
  color: var(--color-bg);
  border: 2px solid var(--color-text);
  font-family: var(--font-sans);
  font-size: 0.875rem;
  font-weight: 700;
  letter-spacing: 0;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.2s ease;
  width: 100%;
}

.contact-submit:hover {
  background: transparent;
  color: var(--color-text);
}

.contact-success {
  padding: 1rem 1.5rem;
  border: 2px solid var(--color-text);
  background: var(--color-bg);
  margin-bottom: 2rem;
  text-align: center;
}

.contact-success p {
  margin: 0;
  font-size: 0.875rem;
  font-weight: 700;
}

.contact-errors {
  padding: 1rem 1.5rem;
  border: 2px solid var(--color-accent);
  color: var(--color-accent);
  margin-bottom: 2rem;
  font-size: 0.875rem;
}

@media (max-width: 768px) {
  .contact-section {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .contact-row {
    grid-template-columns: 1fr;
  }

  .contact-heading {
    font-size: 1.25rem;
  }
}
</style>

{% schema %}
{
  "name": "Contact Form",
  "tag": "section",
  "class": "contact-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in Touch"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Have a question about an item or need help with your order? Drop us a message and we'll get back to you as soon as possible.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show Phone Field",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_order_number",
      "label": "Show Order Number Field",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}
