{% comment %}
  Image Banner Section - Full-width image with text overlay
  Configurable height, overlay, text position
{% endcomment %}

<section class="banner-section">
  <div class="banner-container" style="height: {{ section.settings.banner_height }}px;">
    {% if section.settings.image != blank %}
      <img
        class="banner-image"
        src="{{ section.settings.image | image_url: width: 2000 }}"
        alt="{{ section.settings.heading | escape }}"
        loading="lazy"
        width="2000"
        height="{{ section.settings.banner_height }}"
      />
    {% else %}
      <div class="banner-placeholder"></div>
    {% endif %}
    <div class="banner-overlay" style="background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});"></div>
    <div class="banner-content banner-content--{{ section.settings.text_position }} banner-text--{{ section.settings.text_color }}">
      {% if section.settings.heading != blank %}
        <h2 class="banner-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="banner-subheading">{{ section.settings.subheading }}</p>
      {% endif %}
      {% if section.settings.button_text != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="banner-btn">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
.banner-container {
  position: relative;
  width: 100%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.banner-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #1a1a1a;
}

.banner-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.banner-content {
  position: relative;
  z-index: 2;
  padding: 3rem;
  max-width: 800px;
}

.banner-content--center {
  text-align: center;
  margin: 0 auto;
}

.banner-content--left {
  text-align: left;
  margin-right: auto;
  margin-left: 3rem;
}

.banner-content--right {
  text-align: right;
  margin-left: auto;
  margin-right: 3rem;
}

.banner-text--light {
  color: #ffffff;
}

.banner-text--dark {
  color: var(--color-text);
}

.banner-heading {
  font-size: clamp(1.5rem, 4vw, 3rem);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0;
  margin: 0 0 1rem;
  line-height: 1.1;
}

.banner-subheading {
  font-size: 1rem;
  line-height: 1.6;
  margin: 0 0 2rem;
  opacity: 0.85;
}

.banner-text--light .banner-btn {
  background: #ffffff;
  color: #000000;
  border-color: #ffffff;
}

.banner-text--light .banner-btn:hover {
  background: transparent;
  color: #ffffff;
}

.banner-text--dark .banner-btn {
  background: var(--color-text);
  color: var(--color-bg);
  border-color: var(--color-text);
}

.banner-text--dark .banner-btn:hover {
  background: transparent;
  color: var(--color-text);
}

.banner-btn {
  display: inline-block;
  padding: 0.75rem 1.5rem;
  border: 2px solid;
  font-size: 0.875rem;
  font-weight: 700;
  letter-spacing: 0;
  text-transform: uppercase;
  text-decoration: none;
  transition: all 0.2s ease;
}

@media (max-width: 768px) {
  .banner-container {
    height: 350px !important;
  }

  .banner-content {
    padding: 2rem 1.5rem;
  }

  .banner-content--left,
  .banner-content--right {
    margin-left: 1.5rem;
    margin-right: 1.5rem;
  }

  .banner-heading {
    font-size: 1.5rem;
  }
}
</style>

{% schema %}
{
  "name": "Image Banner",
  "tag": "section",
  "class": "banner-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "range",
      "id": "banner_height",
      "min": 300,
      "max": 700,
      "step": 50,
      "unit": "px",
      "label": "Banner Height",
      "default": 500
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 10,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 40
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image Banner"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text Position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text Color",
      "options": [
        { "value": "light", "label": "Light (White)" },
        { "value": "dark", "label": "Dark (Black)" }
      ],
      "default": "light"
    }
  ],
  "presets": [
    {
      "name": "Image Banner"
    }
  ]
}
{% endschema %}
