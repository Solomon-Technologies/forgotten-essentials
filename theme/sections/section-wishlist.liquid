{% comment %}
  Wishlist / Favorites Page Section
  Uses localStorage to store product handles, fetches via Shopify AJAX API
{% endcomment %}

<div class="wishlist-page">
  <div class="wishlist-header">
    <h1>{{ section.settings.heading }}</h1>
    <p class="wishlist-subtitle">{{ section.settings.subtitle }}</p>
  </div>

  <div class="wishlist-empty" data-wishlist-empty style="display: none;">
    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
    </svg>
    <p>No saved items yet</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn-primary">Continue Shopping</a>
  </div>

  <div class="wishlist-loading" data-wishlist-loading style="display: none;">
    <p>Loading your favorites...</p>
  </div>

  <div class="wishlist-grid" data-wishlist-grid style="grid-template-columns: repeat({{ section.settings.products_per_row }}, 1fr);"></div>
</div>

<style>
.wishlist-page {
  max-width: 1400px;
  margin: 0 auto;
  padding: 2rem 3rem 4rem;
}

.wishlist-header {
  text-align: center;
  padding: 2rem 0 3rem;
}

.wishlist-header h1 {
  font-size: 1.5rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0;
  margin: 0 0 0.5rem;
}

.wishlist-subtitle {
  font-size: 0.9rem;
  color: var(--color-muted);
  margin: 0;
}

.wishlist-empty {
  text-align: center;
  padding: 4rem 2rem;
}

.wishlist-empty svg {
  color: var(--color-muted);
  margin-bottom: 1.5rem;
}

.wishlist-empty p {
  font-size: 1.1rem;
  color: var(--color-muted);
  margin-bottom: 2rem;
}

.wishlist-loading {
  text-align: center;
  padding: 4rem 2rem;
  color: var(--color-muted);
}

.wishlist-grid {
  display: grid;
  gap: 1.5rem;
}

.wishlist-card {
  position: relative;
}

.wishlist-card a {
  text-decoration: none;
  color: inherit;
}

.wishlist-card-image {
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background: var(--color-cream, #f5f5f5);
  margin-bottom: 0.75rem;
}

.wishlist-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.wishlist-card:hover .wishlist-card-image img {
  transform: scale(1.03);
}

.wishlist-card-info {
  padding: 0 0.25rem;
}

.wishlist-card-title {
  font-size: 0.9rem;
  font-weight: 500;
  margin: 0 0 0.35rem;
  line-height: 1.3;
}

.wishlist-card-price {
  font-size: 0.95rem;
  font-weight: 600;
}

.wishlist-card-remove {
  position: absolute;
  top: 0.5rem;
  right: 0.5rem;
  width: 32px;
  height: 32px;
  background: rgba(255, 255, 255, 0.9);
  border: none;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  transition: background 0.2s ease;
}

.wishlist-card-remove:hover {
  background: rgba(255, 255, 255, 1);
}

@media (max-width: 768px) {
  .wishlist-page {
    padding: 1rem 1.5rem 3rem;
  }

  .wishlist-grid {
    grid-template-columns: repeat(2, 1fr) !important;
  }
}

@media (max-width: 480px) {
  .wishlist-page {
    padding: 1rem 1rem 3rem;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const grid = document.querySelector('[data-wishlist-grid]');
  const emptyState = document.querySelector('[data-wishlist-empty]');
  const loadingState = document.querySelector('[data-wishlist-loading]');

  if (!grid) return;

  let items = [];
  try {
    items = JSON.parse(localStorage.getItem('wishlist')) || [];
  } catch (e) {
    items = [];
  }

  if (items.length === 0) {
    emptyState.style.display = 'block';
    return;
  }

  loadingState.style.display = 'block';

  let loaded = 0;
  const products = [];

  items.forEach(function(handle) {
    fetch('/products/' + handle + '.js')
      .then(function(res) { return res.json(); })
      .then(function(product) {
        products.push(product);
      })
      .catch(function() {
        // Product may have been deleted — remove from wishlist
        const updated = items.filter(function(h) { return h !== handle; });
        localStorage.setItem('wishlist', JSON.stringify(updated));
      })
      .finally(function() {
        loaded++;
        if (loaded === items.length) {
          renderWishlist(products);
        }
      });
  });

  function renderWishlist(products) {
    loadingState.style.display = 'none';

    if (products.length === 0) {
      emptyState.style.display = 'block';
      return;
    }

    grid.innerHTML = products.map(function(p) {
      var image = p.featured_image ? p.featured_image : '';
      var price = (p.price / 100).toFixed(2);
      return '<div class="wishlist-card" data-handle="' + p.handle + '">' +
        '<button class="wishlist-card-remove" data-remove-wishlist="' + p.handle + '" aria-label="Remove from favorites">' +
          '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>' +
        '</button>' +
        '<a href="/products/' + p.handle + '">' +
          '<div class="wishlist-card-image">' +
            (image ? '<img src="' + image + '" alt="' + p.title + '" loading="lazy" />' : '') +
          '</div>' +
          '<div class="wishlist-card-info">' +
            '<h3 class="wishlist-card-title">' + p.title + '</h3>' +
            '<span class="wishlist-card-price">$' + price + '</span>' +
          '</div>' +
        '</a>' +
      '</div>';
    }).join('');

    // Bind remove buttons
    grid.querySelectorAll('[data-remove-wishlist]').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var handle = btn.getAttribute('data-remove-wishlist');
        var current = JSON.parse(localStorage.getItem('wishlist')) || [];
        var updated = current.filter(function(h) { return h !== handle; });
        localStorage.setItem('wishlist', JSON.stringify(updated));

        // Remove card from DOM
        var card = btn.closest('.wishlist-card');
        if (card) card.remove();

        // Update header badge
        var badge = document.querySelector('.wishlist-count');
        if (badge) {
          badge.textContent = updated.length;
          badge.style.display = updated.length > 0 ? 'flex' : 'none';
        }

        // Show empty state if no items left
        if (updated.length === 0) {
          emptyState.style.display = 'block';
        }
      });
    });
  }
});
</script>

{% schema %}
{
  "name": "Wishlist",
  "tag": "section",
  "class": "wishlist-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Saved Items"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Your favorite pieces, all in one place."
    },
    {
      "type": "range",
      "id": "products_per_row",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Products Per Row",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Wishlist"
    }
  ]
}
{% endschema %}
