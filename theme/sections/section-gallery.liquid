{% comment %}
  Gallery Section - Image grid with optional lightbox
  Configurable columns, aspect ratio, and captions
{% endcomment %}

<section class="gallery-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="gallery-container">
    {% if section.settings.heading != blank %}
      <h2 class="gallery-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="gallery-grid gallery-grid--{{ section.settings.columns }}">
        {% for block in section.blocks %}
          <div class="gallery-item gallery-item--{{ section.settings.image_ratio }}" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {% if section.settings.enable_lightbox %}
                <a href="{{ block.settings.image | image_url: width: 1600 }}" class="gallery-link" data-gallery-lightbox="{{ section.id }}" data-index="{{ forloop.index0 }}">
                  <img
                    src="{{ block.settings.image | image_url: width: 800 }}"
                    alt="{{ block.settings.caption | escape }}"
                    loading="lazy"
                    width="800"
                    height="800"
                  />
                  <div class="gallery-overlay">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path><path d="M11 8v6"></path><path d="M8 11h6"></path></svg>
                  </div>
                </a>
              {% elsif block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="gallery-link">
                  <img
                    src="{{ block.settings.image | image_url: width: 800 }}"
                    alt="{{ block.settings.caption | escape }}"
                    loading="lazy"
                    width="800"
                    height="800"
                  />
                  <div class="gallery-overlay"></div>
                </a>
              {% else %}
                <div class="gallery-link">
                  <img
                    src="{{ block.settings.image | image_url: width: 800 }}"
                    alt="{{ block.settings.caption | escape }}"
                    loading="lazy"
                    width="800"
                    height="800"
                  />
                </div>
              {% endif %}
            {% else %}
              <div class="gallery-placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                  <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                  <circle cx="9" cy="9" r="2"></circle>
                  <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
                </svg>
              </div>
            {% endif %}
            {% if block.settings.caption != blank %}
              <p class="gallery-caption">{{ block.settings.caption }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="gallery-empty">
        <p>Add images in the theme editor to build your gallery.</p>
      </div>
    {% endif %}
  </div>

  {% if section.settings.enable_lightbox %}
    <div class="gallery-lightbox" data-gallery-lightbox-modal="{{ section.id }}" style="display: none;">
      <button class="lightbox-close" data-lightbox-close aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
      </button>
      <button class="lightbox-prev" data-lightbox-prev aria-label="Previous">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"></path></svg>
      </button>
      <button class="lightbox-next" data-lightbox-next aria-label="Next">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"></path></svg>
      </button>
      <div class="lightbox-content" data-lightbox-content>
      </div>
    </div>
  {% endif %}
</section>

<style>
.gallery-section {
  padding-left: 3rem;
  padding-right: 3rem;
}

.gallery-container {
  max-width: 1400px;
  margin: 0 auto;
}

.gallery-heading {
  font-size: 1.5rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0;
  margin: 0 0 2.5rem;
  text-align: center;
  color: var(--color-text);
}

.gallery-grid {
  display: grid;
  gap: {{ section.settings.gap_size }}px;
}

.gallery-grid--2 { grid-template-columns: repeat(2, 1fr); }
.gallery-grid--3 { grid-template-columns: repeat(3, 1fr); }
.gallery-grid--4 { grid-template-columns: repeat(4, 1fr); }

.gallery-item {
  position: relative;
  overflow: hidden;
}

.gallery-item--square img,
.gallery-item--square .gallery-placeholder {
  aspect-ratio: 1 / 1;
}

.gallery-item--landscape img,
.gallery-item--landscape .gallery-placeholder {
  aspect-ratio: 4 / 3;
}

.gallery-item--portrait img,
.gallery-item--portrait .gallery-placeholder {
  aspect-ratio: 3 / 4;
}

.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s ease;
}

.gallery-link {
  display: block;
  position: relative;
}

.gallery-link:hover img {
  transform: scale(1.03);
}

.gallery-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
  color: white;
}

.gallery-link:hover .gallery-overlay {
  opacity: 1;
}

.gallery-placeholder {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border: 2px dashed var(--color-border);
  color: var(--color-muted);
}

.gallery-caption {
  font-size: 0.8rem;
  color: var(--color-muted);
  margin: 0.75rem 0 0;
  text-align: center;
}

.gallery-empty {
  text-align: center;
  padding: 3rem;
  color: var(--color-muted);
  border: 2px dashed var(--color-border);
}

/* Lightbox */
.gallery-lightbox {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.9);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lightbox-content {
  max-width: 90vw;
  max-height: 90vh;
}

.lightbox-image {
  max-width: 90vw;
  max-height: 85vh;
  object-fit: contain;
}

.lightbox-close,
.lightbox-prev,
.lightbox-next {
  position: absolute;
  background: none;
  border: 2px solid rgba(255, 255, 255, 0.5);
  color: white;
  cursor: pointer;
  padding: 0.75rem;
  transition: all 0.2s ease;
  z-index: 10;
}

.lightbox-close:hover,
.lightbox-prev:hover,
.lightbox-next:hover {
  border-color: white;
  background: rgba(255, 255, 255, 0.1);
}

.lightbox-close {
  top: 1.5rem;
  right: 1.5rem;
}

.lightbox-prev {
  left: 1.5rem;
  top: 50%;
  transform: translateY(-50%);
}

.lightbox-next {
  right: 1.5rem;
  top: 50%;
  transform: translateY(-50%);
}

@media (max-width: 1024px) {
  .gallery-grid--4 {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  .gallery-section {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .gallery-grid--2,
  .gallery-grid--3,
  .gallery-grid--4 {
    grid-template-columns: repeat(2, 1fr);
  }

  .gallery-heading {
    font-size: 1.25rem;
  }
}

@media (max-width: 480px) {
  .gallery-grid--2,
  .gallery-grid--3,
  .gallery-grid--4 {
    grid-template-columns: 1fr;
  }
}
</style>

{% if section.settings.enable_lightbox %}
<script>
document.addEventListener('DOMContentLoaded', function() {
  var sectionId = '{{ section.id }}';
  var modal = document.querySelector('[data-gallery-lightbox-modal="' + sectionId + '"]');
  if (!modal) return;

  var triggers = document.querySelectorAll('[data-gallery-lightbox="' + sectionId + '"]');
  var contentEl = modal.querySelector('[data-lightbox-content]');
  var lightboxImg = document.createElement('img');
  lightboxImg.className = 'lightbox-image';
  lightboxImg.width = 1600;
  lightboxImg.height = 1200;
  lightboxImg.alt = 'Gallery image';
  contentEl.appendChild(lightboxImg);
  var images = [];
  var currentIndex = 0;

  triggers.forEach(function(trigger, i) {
    images.push(trigger.href);
    trigger.addEventListener('click', function(e) {
      e.preventDefault();
      currentIndex = i;
      showImage(currentIndex);
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    });
  });

  function showImage(idx) {
    lightboxImg.src = images[idx];
  }

  modal.querySelector('[data-lightbox-close]').addEventListener('click', closeModal);
  modal.querySelector('[data-lightbox-prev]').addEventListener('click', function() {
    currentIndex = (currentIndex - 1 + images.length) % images.length;
    showImage(currentIndex);
  });
  modal.querySelector('[data-lightbox-next]').addEventListener('click', function() {
    currentIndex = (currentIndex + 1) % images.length;
    showImage(currentIndex);
  });

  modal.addEventListener('click', function(e) {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', function(e) {
    if (modal.style.display === 'none') return;
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowLeft') { currentIndex = (currentIndex - 1 + images.length) % images.length; showImage(currentIndex); }
    if (e.key === 'ArrowRight') { currentIndex = (currentIndex + 1) % images.length; showImage(currentIndex); }
  });

  function closeModal() {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }
});
</script>
{% endif %}

{% schema %}
{
  "name": "Gallery",
  "tag": "section",
  "class": "gallery-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "portrait", "label": "Portrait (3:4)" }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "gap_size",
      "min": 0,
      "max": 32,
      "step": 4,
      "unit": "px",
      "label": "Gap Size",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "enable_lightbox",
      "label": "Enable Lightbox",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Used when lightbox is disabled"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
